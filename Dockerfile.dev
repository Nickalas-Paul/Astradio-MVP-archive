FROM node:20-bullseye-slim

# Install system dependencies for native builds
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Use existing node user from base image

# Corepack/pnpm setup
RUN corepack enable && corepack prepare pnpm@9.12.1 --activate

WORKDIR /app

# Copy package files first for better caching
COPY --chown=node:node pnpm-lock.yaml package.json .npmrc ./

# Fetch dependencies to cache (hermetic install) with build cache
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm fetch --no-optional

# Copy source code
COPY --chown=node:node . .

# Install from cache only (deterministic) with build cache
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --offline --frozen-lockfile

# Set ownership and permissions
RUN chown -R node:node /app && \
    chmod -R 755 /app

# Switch to non-root user
USER node

# Environment variables
ENV ENABLE_VIZ_ENGINE=1
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV CHOKIDAR_USEPOLLING=1
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Expose ports
EXPOSE 3000 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/readyz || exit 1

# Start both servers
CMD ["bash", "-lc", "PORT=3001 node server/index.js & pnpm run ui:dev"]
