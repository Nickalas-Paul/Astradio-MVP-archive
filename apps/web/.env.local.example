# Next.js web app — copy to apps/web/.env.local for local development

# Same-origin API base (optional; empty uses relative /api routes)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Render/local engine URL for direct video playback (bypasses Vercel 4.5 MB proxy limit)
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000

# Enable inline video on Today sky summary (requires ENABLE_VIDEO_EXPORT=1 on Render)