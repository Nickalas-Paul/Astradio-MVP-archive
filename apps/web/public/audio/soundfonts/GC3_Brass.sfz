<control>
set_cc74=127
label_cc74=Tone 
set_cc1=64
label_cc1=Pitch
set_cc73=0
label_cc73=Attack
set_cc72=0
label_cc72=Release
set_cc2=0
label_cc2=Instrument

default_path=samplesflac/

octave_offset=1		//shift occupied region in octaves on keyboard

image=Background_scherp.png
image_controls=Background_vaag_CC.png

<global>
amp_veltrack=0		//change to 100 to make volume react to velocity

loop_mode=no_loop     //set to "loop_continuous" for infinite notes when holding down key
loop_start=20000
loop_end=160000
loop_crossfade=20000

ampeg_attack=0.001
ampeg_attack_oncc73=5
ampeg_release=0.001
ampeg_release_oncc72=5

gain_oncc130=6		//cc130 is poly-aftertouch
pitch_oncc130=-30
gain_oncc129=6		//cc129 is channel-aftertouch
pitch_oncc129=-30

fil_type=lpf_1p
cutoff=50
cutoff_oncc74=6400
cutoff_smoothcc74=100			//inertia or smoothness in milliseconds

tune=-1200
pitch_oncc1=2400
pitch_smoothcc1=100		//inertia or smoothness in milliseconds

<group>
<region> sample=GC3_Brass/G2.flac key=43 
<region> sample=GC3_Brass/G#2.flac key=44 
<region> sample=GC3_Brass/A2.flac key=45 
<region> sample=GC3_Brass/A#2.flac key=46 
<region> sample=GC3_Brass/B2.flac key=47 
<region> sample=GC3_Brass/C3.flac key=48 
<region> sample=GC3_Brass/C#3.flac key=49 
<region> sample=GC3_Brass/D3.flac key=50 
<region> sample=GC3_Brass/D#3.flac key=51 
<region> sample=GC3_Brass/E3.flac key=52 
<region> sample=GC3_Brass/F3.flac key=53 
<region> sample=GC3_Brass/F#3.flac key=54 
<region> sample=GC3_Brass/G3.flac key=55 
<region> sample=GC3_Brass/G#3.flac key=56 
<region> sample=GC3_Brass/A3.flac key=57 
<region> sample=GC3_Brass/A#3.flac key=58 
<region> sample=GC3_Brass/B3.flac key=59 
<region> sample=GC3_Brass/C4.flac key=60 
<region> sample=GC3_Brass/C#4.flac key=61 
<region> sample=GC3_Brass/D4.flac key=62 
<region> sample=GC3_Brass/D#4.flac key=63 
<region> sample=GC3_Brass/E4.flac key=64 
<region> sample=GC3_Brass/F4.flac key=65 
<region> sample=GC3_Brass/F#4.flac key=66 
<region> sample=GC3_Brass/G4.flac key=67 
<region> sample=GC3_Brass/G#4.flac key=68 
<region> sample=GC3_Brass/A4.flac key=69 
<region> sample=GC3_Brass/A#4.flac key=70 
<region> sample=GC3_Brass/B4.flac key=71 
<region> sample=GC3_Brass/C5.flac key=72 
<region> sample=GC3_Brass/C#5.flac key=73 
<region> sample=GC3_Brass/D5.flac key=74 
<region> sample=GC3_Brass/D#5.flac key=75 
<region> sample=GC3_Brass/E5.flac key=76 
<region> sample=GC3_Brass/F5.flac key=77 