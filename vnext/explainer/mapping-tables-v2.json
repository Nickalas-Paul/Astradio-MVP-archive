{
  "version": "v2.0",
  "description": "Psychology/temperament mapping for text explainer (V1-C). Personality-style language, not cosmic/fate.",
  "last_updated": "2026-02-08",
  "arc_descriptions": {
    "rise_peak_release": {
      "condition": "arc_shape>=0.6",
      "templates": [
        "The shape builds and releases, {tint}.",
        "Tension rises then eases, {tint}.",
        "The arc lifts and comes down, {tint}.",
        "Energy gathers and lets go, {tint}."
      ]
    },
    "gentle_wave": {
      "condition": "arc_shape>=0.4 && arc_shape<0.6",
      "templates": [
        "The flow moves smoothly, {tint}.",
        "Motion stays even and gradual, {tint}.",
        "The arc undulates gently, {tint}.",
        "Pacing stays consistent and clear, {tint}."
      ]
    },
    "plateau_hold": {
      "condition": "arc_shape>=0.2 && arc_shape<0.4",
      "templates": [
        "The shape holds steady, {tint}.",
        "Energy stays level and stable, {tint}.",
        "The arc remains consistent, {tint}.",
        "Pacing holds with patience, {tint}."
      ]
    },
    "mixed_rise_release": {
      "condition": "arc_shape<0.2",
      "templates": [
        "The shape shifts and changes, {tint}.",
        "Motion moves dynamically, {tint}.",
        "The arc adapts and transforms, {tint}.",
        "Pacing shifts and develops, {tint}."
      ]
    }
  },
  "element_tints": {
    "fire": {
      "condition": "fire>0.4",
      "phrase": "with expressive drive and initiation"
    },
    "earth": {
      "condition": "earth>0.4",
      "phrase": "with structure and steadiness"
    },
    "air": {
      "condition": "air>0.4",
      "phrase": "with cognition and patterning"
    },
    "water": {
      "condition": "water>0.4",
      "phrase": "with sensitivity and integration"
    },
    "none": {
      "condition": "default",
      "phrase": "with balanced temperament"
    }
  },
  "movement_descriptions": {
    "stepwise_heavy": {
      "condition": "step_bias>=0.70",
      "primary": "Motion stays mostly connected and stepwise",
      "tint": "Venus/Earth"
    },
    "balanced": {
      "condition": "step_bias>=0.40 && step_bias<=0.69",
      "primary": "Motion balances connected and expansive movement",
      "tint": "Mercury/Air"
    },
    "leaping_lead": {
      "condition": "step_bias<0.40",
      "primary": "Motion leans toward wider leaps and reach",
      "tint": "Uranus/Fire"
    }
  },
  "leap_modifiers": {
    "wide_reaches": {
      "condition": "leap_cap>=5",
      "modifier": ", with wider melodic reach",
      "tint": "Jupiter"
    },
    "close_careful": {
      "condition": "leap_cap<=2",
      "modifier": ", with close, contained motion",
      "tint": "Saturn"
    },
    "none": {
      "condition": "default",
      "modifier": "",
      "tint": ""
    }
  },
  "planet_tints": {
    "Mars": "driven, initiating",
    "Venus": "connecting, relating",
    "Mercury": "quick, adaptive",
    "Saturn": "boundaried, steady",
    "Uranus": "disrupting, shifting",
    "Neptune": "blurring, dissolving",
    "Jupiter": "expansive, reaching"
  },
  "rhythm_classes": {
    "simple_even": {
      "condition": "rhythm_template_id>=0 && rhythm_template_id<=2",
      "class": "Steady, even pulse",
      "tint": "Earth"
    },
    "lightly_shifting": {
      "condition": "rhythm_template_id>=3 && rhythm_template_id<=4",
      "class": "Lightly shifting patterns",
      "tint": "Mercury/Air"
    },
    "strong_accented": {
      "condition": "rhythm_template_id>=5 && rhythm_template_id<=6",
      "class": "Strong, accented pulse",
      "tint": "Mars"
    },
    "fluid_open": {
      "condition": "rhythm_template_id==7",
      "class": "Fluid, open timing",
      "tint": "Neptune"
    }
  },
  "syncopation_descriptions": {
    "pronounced": {
      "condition": "syncopation_bias>=0.60",
      "description": "with pronounced off-beats",
      "tint": "Uranus"
    },
    "subtle": {
      "condition": "syncopation_bias>=0.30 && syncopation_bias<=0.59",
      "description": "with subtle shifts",
      "tint": ""
    },
    "straight": {
      "condition": "syncopation_bias<0.30",
      "description": "with steady time",
      "tint": ""
    }
  },
  "density_descriptions": {
    "sparse": {
      "condition": "density_level>=0.0 && density_level<=0.3",
      "description": "Texture stays spacious and clear"
    },
    "balanced": {
      "condition": "density_level>=0.4 && density_level<=0.6",
      "description": "Texture balances clarity and weight"
    },
    "dense": {
      "condition": "density_level>=0.7 && density_level<=1.0",
      "description": "Texture layers with more weight"
    },
    "stellium_suffix": {
      "condition": "stellium_count>=3",
      "suffix": ", with several influences in play"
    }
  },
  "tempo_descriptions": {
    "brisk": {
      "condition": "tempo_norm>0.7",
      "description": "at a brisk pace."
    },
    "measured": {
      "condition": "tempo_norm>=0.4 && tempo_norm<=0.7",
      "description": "at a measured pace."
    },
    "slow": {
      "condition": "tempo_norm<0.4",
      "description": "at a slow pace."
    }
  },
  "motif_descriptions": {
    "frequent": {
      "condition": "motif_rate>0.7",
      "description": "Recurring ideas return often."
    },
    "moderate": {
      "condition": "motif_rate>=0.4 && motif_rate<=0.7",
      "description": "Recurring ideas appear at a moderate rate."
    },
    "sparse": {
      "condition": "motif_rate<0.4",
      "description": "Few recurring ideas; forward motion leads."
    }
  },
  "astro_colors": {
    "element_adjectives": {
      "fire": "expressive, initiating",
      "earth": "structured, steady",
      "air": "cognitive, patterning",
      "water": "sensitive, integrating"
    },
    "planet_adjectives": {
      "Mars": "driven",
      "Venus": "relating",
      "Mercury": "adaptive",
      "Saturn": "steady",
      "Jupiter": "expansive",
      "Uranus": "shifting",
      "Neptune": "dissolving"
    }
  },
  "template_structures": {
    "short": {
      "pattern": "[psych_tone/astro_color] [movement] [arc_desc]",
      "optional": "add rhythm_feel if space",
      "max_length": 120
    },
    "long": {
      "s1": "[psych_tone/astro_color]",
      "s2": "[movement]",
      "s3": "[rhythm_feel] + tempo fragment",
      "s4": "[density_desc]",
      "s5": "[motif_desc]",
      "max_length": 300
    },
    "bullets": {
      "items": ["movement", "arc_desc", "rhythm_feel", "density_desc", "motif_desc", "motion_profile", "music_facts", "gate hints when applicable"],
      "count": "4-8 items"
    }
  },
  "overlay_deltas": {
    "step_bias_more": {
      "condition": "step_bias_delta >= +0.10",
      "description": "more stepwise than natal"
    },
    "leap_cap_wider": {
      "condition": "leap_cap_delta >= +1",
      "description": "wider leaps than natal"
    },
    "syncopation_more": {
      "condition": "syncopation_delta >= +0.15",
      "description": "more syncopated feel than natal"
    }
  },
  "sandbox_hints": {
    "step_leap_fail": {
      "condition": "step_leap gate fails",
      "hint": "Try **step_bias +0.1** or **leap_cap → 3**."
    },
    "rhythm_div_fail": {
      "condition": "rhythm_div gate fails",
      "hint": "Switch to template 3 or raise syncopation slightly."
    },
    "arc_fail": {
      "condition": "arc gate fails",
      "hint": "Adjust arc to a clearer rise-peak-release."
    }
  },
  "synonym_variations": {
    "seed_based": {
      "description": "Use controls.hash % 4 to select from 4 synonym sets",
      "sets": [
        { "gentle": "soft", "rise": "ascent", "fall": "descent", "steady": "consistent", "balanced": "harmonious" },
        { "gentle": "smooth", "rise": "climb", "fall": "drop", "steady": "regular", "balanced": "even" },
        { "gentle": "subtle", "rise": "uplift", "fall": "decline", "steady": "stable", "balanced": "well-proportioned" },
        { "gentle": "delicate", "rise": "elevation", "fall": "lowering", "steady": "constant", "balanced": "equilibrated" }
      ]
    }
  }
}
