{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist/vnext",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "scripts/daily-monitoring.ts",
    "scripts/test-astro-coupling.ts", 
    "scripts/test-wheel-contract.ts",
    "scripts/freeze-eval-set.ts",
    "scripts/model-provenance.ts",
    "scripts/ci-path-guard.ts",
    "scripts/verify-teacher-consistency.ts",
    "scripts/enforce-quality-thresholds.ts",
    "scripts/canary-promotion.ts"
  ]
}
