{
  "name": "astradio-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.12.2 <21",
    "npm": ">=10.0.0"
  },
  "description": "Astradio – single-process server (static + ephemeris via Swiss Ephemeris)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "engine:dev": "nodemon server/index.js",
    "web:dev": "next dev apps/web -p 3000",
    "dev:all": "concurrently \"npm run engine:dev\" \"npm run web:dev\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "verify:migration": "node scripts/verify-migration-sql.js",
    "smoke:phase4": "node scripts/phase4-smoke.js",
    "vnext:build": "tsc -p vnext/tsconfig.json && node scripts/copy-vnext-assets.js && node scripts/copy-vnext-models.js",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "vnext:label": "node dist/vnext/teacher/label-from-rules.js",
    "vnext:smoke": "node dist/vnext/scripts/smoke.js",
    "vnext:materialize": "node dist/vnext/scripts/materialize-snapshots.js",
    "vnext:audition": "node dist/vnext/scripts/run-audition.js",
    "vnext:train": "node dist/vnext/scripts/train-student.js",
    "vnext:train-v2": "node dist/vnext/scripts/train-student-v2.js",
    "vnext:train-v1": "node dist/vnext/scripts/train-student-v1.js",
    "vnext:mock-model": "node dist/vnext/scripts/create-mock-model.js",
    "diag:sandbox": "npm run vnext:build && node dist/vnext/vnext/scripts/diag-sandbox-404.js",
    "verify:phase4c": "npm run vnext:build && node dist/vnext/vnext/scripts/phase4c-sandbox-verification.js",
    "verify:nomocks": "node dist/scripts/check-placeholders.js",
    "verify:fallback": "node dist/scripts/check-fallback-share.js",
    "verify:realml": "npm run vnext:build && npm run vnext:audition && npm run verify:nomocks && npm run verify:fallback",
    "test:astro-coupling": "npm run vnext:build && node dist/vnext/scripts/test-astro-coupling.js",
    "test:wheel-contract": "npm run vnext:build && node dist/vnext/scripts/test-wheel-contract.js",
    "freeze-eval-set": "npm run vnext:build && node dist/vnext/scripts/freeze-eval-set.js",
    "model-provenance": "npm run vnext:build && node dist/vnext/scripts/model-provenance.js",
    "phase2c-eval": "npm run vnext:build && node dist/vnext/scripts/run-phase2c-eval.js",
    "generate-snapshots": "npm run vnext:build && node dist/vnext/scripts/generate-real-snapshots.js",
    "ci-path-guard": "npm run vnext:build && node dist/vnext/scripts/ci-path-guard.js",
    "verify-teacher": "npm run vnext:build && node dist/vnext/scripts/verify-teacher-consistency.js",
    "enforce-thresholds": "npm run vnext:build && node dist/vnext/scripts/enforce-quality-thresholds.js",
    "canary-promotion": "npm run vnext:build && node dist/vnext/scripts/canary-promotion.js",
    "test:pipeline": "npm run test:astro-coupling && npm run test:wheel-contract",
    "ci:vnext": "npm run vnext:build && npm run vnext:materialize && npm run vnext:audition",
    "ci:quality": "npm run ci:vnext && npm run test:pipeline && npm run ci-path-guard && npm run enforce-thresholds",
    "ci:full": "npm run ci:quality && npm run verify-teacher && npm run freeze-eval-set eval",
    "test:contract": "jest tests/engine-adapter.contract.test.ts",
    "test:e2e": "playwright test tests/e2e.smoke.spec.ts",
    "test:integration": "node scripts/test-integration.js",
    "test:all": "npm run test:contract && npm run test:e2e",
    "smoke:server": "node scripts/smoke-test.js",
    "build:dev": "NODE_ENV=development npm run vnext:build",
    "build:prod": "NODE_ENV=production npm run vnext:build",
    "build:ci": "NODE_ENV=ci npm run vnext:build",
    "verify:deterministic": "node scripts/build-hash.js",
    "test:audio-determinism": "npm run vnext:build && node dist/vnext/vnext/scripts/audio-renderer-determinism.js",
    "test:audio-contract": "npm run vnext:build && node dist/vnext/vnext/scripts/compose-audio-contract-test.js",
    "test:audio-sanity": "npm run vnext:build && node dist/vnext/vnext/scripts/audio-sanity.js",
    "test:audio": "npm run vnext:build && node dist/vnext/vnext/scripts/audio-renderer-determinism.js && node dist/vnext/vnext/scripts/compose-audio-contract-test.js && node dist/vnext/vnext/scripts/audio-sanity.js",
    "test:compose-soak": "npm run vnext:build && node dist/vnext/vnext/scripts/compose-determinism-soak.js",
    "test:compose-live-soak": "npm run vnext:build && node dist/vnext/vnext/scripts/compose-live-soak.js",
    "test:compose-golden-run": "npm run vnext:build && node dist/vnext/vnext/scripts/compose-golden-run.js",
    "vnext:golden": "npm run vnext:build && node dist/vnext/vnext/scripts/test-golden-compose.js && node dist/vnext/vnext/scripts/test-golden-compat.js",
    "vnext:golden:update": "npm run vnext:build && echo Run with UPDATE_GOLDEN=1 node dist/vnext/vnext/scripts/test-golden-compose.js and test-golden-compat.js to refresh baselines",
    "test:compose-golden-baseline": "npm run vnext:build && node scripts/golden-baseline.js",
    "test:plan-hash": "npm run vnext:build && node dist/vnext/vnext/scripts/test-plan-hash.js",
    "test:midi-determinism": "npm run vnext:build && node dist/vnext/vnext/scripts/test-midi-determinism.js",
    "mirror-report": "npm run vnext:build && node dist/vnext/vnext/scripts/mirror-report.js",
    "test:mirror-determinism": "npm run vnext:build && node dist/vnext/vnext/scripts/mirror-determinism.js",
    "test:harmony-blend": "npm run vnext:build && node dist/vnext/vnext/scripts/harmony-blend-regression.js",
    "test:performance-verification": "npm run vnext:build && node dist/vnext/vnext/scripts/performance-verification.js",
    "test:instrumentation-verification": "npm run vnext:build && node dist/vnext/vnext/scripts/instrumentation-verification.js",
    "test:mix-balance-verification": "npm run vnext:build && node dist/vnext/vnext/scripts/mix-balance-verification.js",
    "test:fx-routing-verification": "npm run vnext:build && node dist/vnext/vnext/scripts/fx-routing-verification.js",
    "test:reverb-send-verification": "npm run vnext:build && node dist/vnext/vnext/scripts/reverb-send-verification.js",
    "test:provenance-verification": "npm run vnext:build && node dist/vnext/vnext/scripts/provenance-verification.js",
    "check:single-compose": "node scripts/check-single-compose.js",
    "lint:web:safety": "node scripts/check-no-browser-globals-top-level.js",
    "worker:export": "node workers/export-worker.js",
    "seed:phantoms": "node scripts/seed-phantom-users.js",
    "phase1:smoke": "node scripts/phase1-smoke.js",
    "phase5:guard": "npm run vnext:build && node dist/vnext/vnext/scripts/phase5-guard.js",
    "phase5:verify-intent": "npm run vnext:build && node dist/vnext/vnext/scripts/verify-intent-profiles.js",
    "phase5:verify-scoring": "npm run vnext:build && node dist/vnext/vnext/scripts/verify-intent-scoring.js",
    "phase5:verify-phantoms": "npm run vnext:build && node dist/vnext/vnext/scripts/verify-phantoms.js",
    "phase5:verify-constellations": "npm run vnext:build && node dist/vnext/vnext/scripts/verify-constellations.js",
    "phase5:verify-relational": "npm run vnext:build && node dist/vnext/vnext/scripts/verify-relational-groups.js",
    "phase5:verify-owner-identity": "npm run vnext:build && node dist/vnext/vnext/scripts/verify-owner-identity.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@simplewebauthn/server": "^8.3.6",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "argon2": "^0.31.2",
    "autoprefixer": "^10.4.0",
    "aws-sdk": "^2.1490.0",
    "clamscan": "^2.0.0",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "express-http-proxy": "^1.6.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-request-id": "^1.4.1",
    "express-session": "^1.17.3",
    "express-slow-down": "^2.0.1",
    "express-validator": "^7.0.1",
    "framer-motion": "^10.16.0",
    "google-auth-library": "^9.14.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "multer": "^2.0.0-rc.2",
    "next": "^14.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "postcss": "^8.4.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^4.6.10",
    "speakeasy": "^2.0.0",
    "swisseph": "^0.5.17",
    "tailwindcss": "^3.3.0",
    "tone": "^15.1.22",
    "tzlookup": "^1.4.0",
    "ulid": "^2.3.0",
    "uuid": "^11.1.0",
    "wav-encoder": "^1.3.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.22.4",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.2",
    "undici": "^6.23.0"
  }
}