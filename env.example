# Development Environment Variables
# Copy this file to .env.development and update values as needed

# Database
POSTGRES_PASSWORD=dev_password_123

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Application
NODE_ENV=development
ENABLE_VIZ_ENGINE=1
NEXT_TELEMETRY_DISABLED=1

# Optional: Override default ports
# PORT=3001
# NEXT_PORT=3000

# Frontend → Backend (Vercel → Render)
# Set on Vercel to Render backend URL (no trailing slash). Empty = local dev (Next proxies).
NEXT_PUBLIC_API_BASE_URL=
# Server-side proxy (Next API routes → backend). Same value on Vercel.
API_BASE_URL=

# Shared secret between Vercel (Next API proxies) and Render (engine).
# Next sends x-proxy-secret on every engine fetch; engine rejects /api without a match when set.
# Use the same random value on Vercel and Render. Leave unset for local-only dev without the gate.
PROXY_SHARED_SECRET=

# JWT access tokens (Render engine — POST /api/auth/token, Bearer middleware)
# Required on Render for mobile auth. JWT_EXPIRES_IN is minutes as integer (default 15); use 43200 for 30 days.
JWT_SECRET=
JWT_EXPIRES_IN=15

# Session signing (Vercel only, min 32 chars)
ASTRADIO_SESSION_SECRET=

# Frontend URL for email links (verification, password reset)
FRONTEND_URL=http://localhost:3000

# Optional: Override default URLs
# DATABASE_URL=postgresql://postgres:dev_password_123@localhost:5432/astradio
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=astradio-dev